# Autenticação Auth.js + Discord
# Gere com: npm exec auth secret
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
DISCORD_GUILD_ID=

# IDs de usuários do Discord autorizados a abrir /admin.
# Para mais de um administrador, separe os IDs por vírgulas.
ADMIN_DISCORD_IDS=

# Opcional. Se ficar vazio, os convites usam AUTH_SECRET para assinatura.
# Gere com: openssl rand -base64 32
ROOM_SIGNING_SECRET=

# LiveKit Cloud (a URL começa com wss://)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Necessário somente se o bot da pasta discord-bot estiver em uso.
# Use o mesmo valor no site da Vercel e no processo do bot.
TELADIRETA_BOT_SECRET=
