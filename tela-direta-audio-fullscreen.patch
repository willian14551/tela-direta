+
+.audio-mixer-list {
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  padding: 4px 14px 14px;
+}
+
+.audio-mixer-empty {
+  margin: 14px 2px 2px;
+  color: var(--text-muted);
+  font-size: 13px;
+  line-height: 1.5;
+}
+
+.participant-volume {
+  padding: 14px 2px;
+  border-bottom: 1px solid rgba(51, 54, 106, 0.72);
