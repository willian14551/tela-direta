+  font-size: 14px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.participant-volume-avatar {
+  width: 29px;
+  height: 29px;
+  flex: 0 0 auto;
+  display: inline-grid;
+  place-items: center;
+  border-radius: 50%;
+  background: var(--surface-2);
+  color: var(--accent-strong);
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.volume-control + .volume-control {
+  margin-top: 11px;
+}
+
+.volume-control-label {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin: 0 1px 6px 39px;
+  color: var(--text-muted);
+  font-size: 11px;
+}
+
+.volume-control-label output {
+  color: var(--text);
+  font-variant-numeric: tabular-nums;
+}
+
+.volume-control-inputs {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+}
+
+.volume-mute-button {
+  width: 30px;
+  height: 30px;
+  flex: 0 0 auto;
+  display: inline-grid;
+  place-items: center;
+  padding: 0;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+
+.volume-mute-button:hover {
+  background: var(--surface-2);
+  color: var(--text);
+}
+
+.volume-mute-button.is-muted {
+  color: var(--danger);
+}
+
+.volume-control-inputs input[type="range"] {
+  width: 100%;
+  height: 5px;
+  appearance: none;
+  border-radius: 999px;
+  cursor: pointer;
+}
+
+.volume-control-inputs input[type="range"]::-webkit-slider-thumb {
+  width: 15px;
+  height: 15px;
+  appearance: none;
+  border: 2px solid var(--surface);
+  border-radius: 50%;
+  background: var(--accent-strong);
+  box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35);
+}
+
+.volume-control-inputs input[type="range"]::-moz-range-thumb {
+  width: 12px;
+  height: 12px;
+  border: 2px solid var(--surface);
+  border-radius: 50%;
+  background: var(--accent-strong);
+  box-shadow: 0 1px 5px rgba(0, 0, 0, 0.35);
+}
+
+.fullscreen-error {
+  position: absolute;
+  z-index: 22;
+  top: max(68px, calc(env(safe-area-inset-top) + 60px));
+  right: max(14px, env(safe-area-inset-right));
+  width: min(340px, calc(100vw - 28px));
+  margin: 0;
+  padding: 10px 12px;
+  border: 1px solid rgba(255, 122, 122, 0.45);
+  border-radius: 9px;
+  background: rgba(55, 25, 42, 0.96);
+  color: #ffd4d4;
+  font-size: 12px;
+  line-height: 1.45;
+}
+
+@media (max-width: 560px) {
+  .conference-tool-button {
+    width: 42px;
+    padding: 0;
+  }
+
+  .conference-tool-button span {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+  }
+
+  .audio-mixer {
+    max-height: calc(100% - 136px);
+  }
+}
